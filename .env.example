# Copy to .env and adjust.  docker compose reads it automatically.

# ---- where the Strata sources come from -----------------------------------------------------------
# A git URL pinned to a tag or commit - nothing to clone by hand, the build fetches it.
# Pin a TAG OR COMMIT, never a branch: a branch changes the build without changing anything you can see.
# To build against a local checkout instead (only needed if you modify Strata):  STRATA_SRC=./src
STRATA_SRC=https://github.com/Niko1221/Strata.git#v0.1.21

# ---- hardware ------------------------------------------------------------------------------------
# CUDA architectures to compile for: 120 = RTX 50, 89 = RTX 40, 86 = RTX 30.  "86;120" builds both.
CUDA_ARCHITECTURES=120

# OFF builds ggml with -march=native: a little better code for this exact CPU, but the image then runs
# ONLY on it.  Safe when you build on the machine that will run it; use ON if the image travels.
STRATA_PORTABLE=ON

# Which card the container sees.  A bare index works, but `nvidia-smi -L` prints UUIDs that survive a
# reboot reordering the PCI bus:  STRATA_GPU_DEVICE=GPU-1a2b3c4d-....
# Pinning one card also keeps it at index 0 inside the container, so no --gpu ends up in the config.
STRATA_GPU_DEVICE=0

# ---- model ---------------------------------------------------------------------------------------
STRATA_FAMILY=qwen
# Q2_0 | IQ2_XS | IQ3_XXS | IQ3_S   (IQ3_S: ~84 GB download, 50.3 GB of experts, needs 62 GB of RAM)
STRATA_MODEL=IQ3_S
# 8192 | 32768 | 65536 | 131072 | 262144.  262144 needs more than 90 GB of RAM with IQ3_S, or setup
# caps it at 131072.  The KV cache costs only ~3.6 GB at 262K: just 12 of the 48 layers are attention.
STRATA_CONTEXT=262144
# int8 (what every published number was measured with) or q4_0 (half the memory, less precise)
STRATA_KV=int8
# gpu | cpu | none
STRATA_VISION=gpu

# ---- conversation cache --------------------------------------------------------------------------
# Checkpoints let a request resume instead of reading a long prompt again - the difference between
# seconds and minutes per turn for a coding agent.  ~118 MB of RAM each; the engine defaults (6 and
# 16384) are sized for a 64 GB desktop.
STRATA_PROMPT_CACHE=24
STRATA_PROMPT_CACHE_EVERY=8192

# ---- paths and network ---------------------------------------------------------------------------
# ~92 GB for IQ3_S with vision.  Put it on the NVMe.
STRATA_DATA_DIR=./strata-data
STRATA_CONFIG_VOLUME=./strata-config

STRATA_PORT=8080
# The host address the port is published on.  No API key is configured, so anyone who can reach this
# address can use the model: keep it on a LAN interface, never a public one.
# 127.0.0.1 = this machine only;  192.168.1.10 = that one LAN address;  0.0.0.0 = every interface.
STRATA_BIND=127.0.0.1
